# 서버
PORT=3000

# GitHub App
GITHUB_APP_ID=
# PEM 키 전체를 한 줄로 붙여넣어도 됨 (개행이 \n 리터럴로 들어와도 코드가 자동 변환함)
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# 코멘트 멘션 트리거에 쓰는 봇(App) 슬러그. '@dovi-code-assist' 로 멘션 / 봇 계정은 dovi-code-assist[bot]
GITHUB_BOT_LOGIN=

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_REVIEW_REQUEST_TOPIC=pr.review.requested
KAFKA_REVIEW_COMPLETED_TOPIC=pr.review.completed
KAFKA_REVIEW_FAILED_TOPIC=pr.review.failed
KAFKA_COMMENT_ANSWER_REQUEST_TOPIC=pr.comment.answer.requested
KAFKA_COMMENT_ANSWER_COMPLETED_TOPIC=pr.comment.answer.completed
KAFKA_COMMENT_ANSWER_FAILED_TOPIC=pr.comment.answer.failed
KAFKA_REPO_INDEX_REQUEST_TOPIC=repo.index.requested
KAFKA_REVIEW_FEEDBACK_TOPIC=pr.comment.reflected
KAFKA_SANDBOX_PROBE_REQUEST_TOPIC=pr.sandbox.probe.requested
KAFKA_SANDBOX_PROBE_COMPLETED_TOPIC=pr.sandbox.probe.completed

# 샌드박스 프로브(빌드/기동 런타임 검증) 발행 킬스위치. 컨슈머 플래그만으로는
# 이벤트가 쌓여서 재활성화 시 리플레이되므로, 발행 자체를 끄는 별도 플래그가
# 필요하다 (기본값 false — 미설정 시 발행 안 함). 레포별 opt-in(DOVI.md의
# `## Sandbox Probe`)과는 별개다.
SANDBOX_PROBE_PUBLISH_ENABLED=false

# Redis
REDIS_URL=redis://localhost:6379

# Discord 알림 (선택 - 비워두면 자동 비활성화, 부팅에는 영향 없음)
DISCORD_WEBHOOK_URL=
